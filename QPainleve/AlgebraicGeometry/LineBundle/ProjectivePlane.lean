/-!
# The Picard group and intersection pairing of the projective plane

The Picard group of the projective plane over a field is freely generated by `𝒪(1)`.
Picard excision gives cyclicity from the complement of an affine coordinate chart.
Restriction to a coordinate line and Tau Ceti's `projectiveLine.picardDegreeEquiv`
give degree one on `𝒪(1)`. The calculation `eulerCharBelow_twistingSheaf_projectivePlane` then
gives the Euler characteristic of every class. The resulting intersection pairing is multiplication
of degrees.

See Hartshorne, *Algebraic Geometry*, Chapter II, Proposition 6.4 (divisor class groups and
hyperplane complements), and the Stacks Project, Lemma 31.29.5 (tag 0BXJ).
-/

public section

open AlgebraicGeometry CategoryTheory HomogeneousLocalization
open TauCeti.AlgebraicGeometry TauCeti.SymmetricAlgebra

universe u

namespace QPainleve

/-- The projective plane, with the standard three homogeneous coordinates. -/
noncomputable abbrev projectivePlane (k : Type u) [CommRing k] : Scheme.{u} :=
  Proj (homogeneousSubmodule k (Fin 3 → k))

namespace projectivePlane

noncomputable section

variable (k : Type u) [Field k]

local notation "P" => projectivePlane k
local notation "𝒜" => homogeneousSubmodule k (Fin 3 → k)
local notation "basis" => Pi.basisFun k (Fin 3)
local notation "c" => fun i : Fin 3 ↦ SymmetricAlgebra.ι k (Fin 3 → k) (basis i)

/-- The class of the twisting sheaf `𝒪(n)` in the native Picard group of the plane. -/
def twistingClass (n : ℤ) : LineBundleClass P :=
  LineBundleClass.mk ⟨Proj.twistingSheaf 𝒜 n, inferInstance⟩

/-- The class of `𝒪(n)` is the `n`th tensor power of the hyperplane class. -/
theorem twistingClass_eq_zpow (n : ℤ) : twistingClass k n = twistingClass k 1 ^ n :=
  Proj.lineBundleClass_twistingSheaf_eq_zpow
    (fun i : ULift.{u} (Fin 3) ↦ c i.down)
    (fun i ↦ ι_mem_homogeneousSubmodule k _ (basis i.down))
    (by simpa only [iSup_ulift] using iSup_basicOpen_ι_eq_top k _ basis (basis).span_eq) n

private theorem existsUnique_codimensionOnePoint_notMem_coordOpen :
    ∃! x : CodimensionOnePoint P, (x : P) ∉ Proj.basicOpen 𝒜 (c 0) := by
  refine Proj.existsUnique_codimensionOnePoint_notMem_basicOpen
    (ι_mem_homogeneousSubmodule k _ (basis 0)) Nat.one_pos
    (SymmetricAlgebra.prime_ι ((basis).ne_zero 0)) ?_
  intro h
  have h1 : c 1 ∈ Ideal.span {c 0} :=
    h (HomogeneousIdeal.mem_irrelevant_of_mem 𝒜 Nat.one_pos
      (ι_mem_homogeneousSubmodule k _ (basis 1)))
  obtain ⟨a, ha⟩ := Submodule.mem_span_singleton.mp
    (SymmetricAlgebra.ι_dvd_ι_iff.mp (Ideal.mem_span_singleton.mp h1))
  have hcoord := congrFun ha (1 : Fin 3)
  simp [Pi.basisFun_apply] at hcoord

/-- The standard projective plane has Krull dimension two. -/
theorem topologicalKrullDim_eq : topologicalKrullDim P = 2 :=
  (basis).topologicalKrullDim_proj (n := 2)

/-- The projective plane has factorial local rings. -/
instance (x : P) : UniqueFactorizationMonoid ((P).presheaf.stalk x) :=
  (basis).uniqueFactorizationMonoid_stalk_proj x

private theorem exists_generator :
    ∃ g : LineBundleClass P, ∀ a : LineBundleClass P, ∃ n : ℤ, g ^ n = a := by
  classical
  let U := Proj.awayι 𝒜 (c 0) (ι_mem_homogeneousSubmodule k _ (basis 0)) Nat.one_pos
  let e := (basis).awayEquivMvPolynomial 0
  have hpoly := LineBundleClass.subsingleton_spec (MvPolynomial (Fin 2) k)
  have : Subsingleton (LineBundleClass (Spec (.of (Away 𝒜 (c 0))))) :=
    @Equiv.subsingleton _ _
      (LineBundleClass.pullbackEquiv (Scheme.Spec.mapIso e.toCommRingCatIso.op)).toEquiv hpoly
  obtain ⟨η, hη, huniq⟩ := existsUnique_codimensionOnePoint_notMem_coordOpen k
  refine ⟨LineBundleClass.primeDivisorClass η, fun a ↦ ?_⟩
  have hs : {LineBundleClass.primeDivisorClass x |
      (x : CodimensionOnePoint P) (_ : (x : P) ∉ Set.range U)} =
        {LineBundleClass.primeDivisorClass η} := by
    have hU : Set.range U = (Proj.basicOpen 𝒜 (c 0) : Set P) :=
      congrArg (fun W : (P).Opens ↦ (W : Set P)) (Proj.opensRange_awayι 𝒜 _ _ _)
    ext x
    constructor
    · rintro ⟨p, hp, rfl⟩
      rw [hU] at hp
      rw [Set.mem_singleton_iff, huniq p hp]
    · intro hx
      obtain rfl := Set.mem_singleton_iff.mp hx
      exact ⟨η, by rw [hU]; exact hη, rfl⟩
  have hmem := (LineBundleClass.pullback_eq_one_iff_mem_closure_of_isOpenImmersion U).mp
    (Subsingleton.elim (LineBundleClass.pullback U a) 1)
  rw [hs, ← Subgroup.zpowers_eq_closure] at hmem
  exact Subgroup.mem_zpowers_iff.mp hmem

private def lineProjection : (Fin 3 → k) →ₗ[k] (Fin 2 → k) :=
  LinearMap.funLeft k k (0 : Fin 3).succAbove

private def lineGradedMap : 𝒜 →+*ᵍ homogeneousSubmodule k (Fin 2 → k) :=
  SymmetricAlgebra.gradedMap k (lineProjection k)

private theorem lineGradedMap_surjective : Function.Surjective (lineGradedMap k) :=
  fun y ↦ by
    simpa only [lineGradedMap, SymmetricAlgebra.gradedMap_apply] using
      SymmetricAlgebra.map_surjective k (lineProjection k)
        (LinearMap.funLeft_surjective_of_injective k k _
          (fun _ _ h ↦ Fin.succAbove_right_injective h)) y

private def coordinateLineι : projectiveLine k ⟶ P :=
  Proj.map (lineGradedMap k)
    (HomogeneousIdeal.irrelevant_le_map_of_surjective _ (lineGradedMap_surjective k))

private def coordinateLineDegree : Additive (LineBundleClass P) →+ ℤ :=
  (projectiveLine.picardDegreeEquiv k).toAddMonoidHom.comp
    (LineBundleClass.pullbackHom (coordinateLineι k)).toAdditive

private theorem coordinateLineDegree_twistingClass_one :
    coordinateLineDegree k (Additive.ofMul (twistingClass k 1)) = 1 := by
  have h := HomogeneousIdeal.irrelevant_le_map_of_surjective
    (lineGradedMap k) (lineGradedMap_surjective k)
  have hL : LineBundleClass.pullback (coordinateLineι k) (twistingClass k 1) =
      ((projectiveLine.picardDegreeEquiv k).symm 1).toMul := by
    rw [projectiveLine.picardDegreeEquiv_symm_apply, toMul_ofMul, twistingClass,
      LineBundleClass.pullback_mk, LineBundleClass.mk_eq_mk_iff]
    exact ⟨Proj.pullbackTwistingSheafIso (lineGradedMap k) h c
      (fun i ↦ ι_mem_homogeneousSubmodule k _ (basis i))
      (iSup_basicOpen_ι_eq_top k _ basis (basis).span_eq) 1⟩
  rw [coordinateLineDegree, AddMonoidHom.comp_apply, MonoidHom.toAdditive_apply_apply,
    LineBundleClass.pullbackHom_apply, toMul_ofMul, hL, ofMul_toMul]
  exact (projectiveLine.picardDegreeEquiv k).apply_symm_apply 1

/-- The Picard group of the projective plane over a field, in additive notation,
is isomorphic to the integers by the degree of the twist. -/
def picardDegreeEquiv : Additive (LineBundleClass P) ≃+ ℤ := by
  let H := Additive.ofMul (twistingClass k 1)
  let deg := coordinateLineDegree k
  have hH : deg H = 1 := coordinateLineDegree_twistingClass_one k
  have hleft : Function.LeftInverse deg (zmultiplesHom _ H) := by
    intro n
    simp [zmultiplesHom_apply, hH]
  have hsurj : Function.Surjective (zmultiplesHom _ H) := by
    obtain ⟨g, hg⟩ := exists_generator k
    let G := Additive.ofMul g
    have hg' (a : Additive (LineBundleClass P)) : ∃ n : ℤ, n • G = a := hg a.toMul
    obtain ⟨d, hd⟩ := hg' H
    have hd' : deg G * d = 1 := by
      simpa [map_zsmul, zsmul_eq_mul, mul_comm, hH] using congrArg deg hd
    intro a
    obtain ⟨n, hn⟩ := hg' a
    refine ⟨n * deg G, ?_⟩
    rw [zmultiplesHom_apply, ← hn, ← hd, smul_smul, mul_assoc, hd', mul_one]
  exact (AddEquiv.ofBijective (zmultiplesHom _ H) ⟨hleft.injective, hsurj⟩).symm

/-- The inverse degree map sends `n` to the class of `𝒪(n)`. -/
@[simp]
theorem picardDegreeEquiv_symm_apply (n : ℤ) :
    (picardDegreeEquiv k).symm n = Additive.ofMul (twistingClass k n) := by
  rw [twistingClass_eq_zpow k n, ofMul_zpow]
  rfl

/-- The twisting sheaf `𝒪(n)` has degree `n`. -/
@[simp]
theorem picardDegreeEquiv_twistingClass (n : ℤ) :
    picardDegreeEquiv k (Additive.ofMul (twistingClass k n)) = n :=
  (picardDegreeEquiv k).toEquiv.eq_symm_apply.mp
    (picardDegreeEquiv_symm_apply k n).symm

/-- A line bundle is isomorphic to the twist of its Picard degree, and that twist is unique. -/
@[simp]
theorem nonempty_iso_twistingSheaf_iff (L : InvertibleSheaf P) (n : ℤ) :
    Nonempty (L.obj ≅ Proj.twistingSheaf 𝒜 n) ↔
      picardDegreeEquiv k (Additive.ofMul (LineBundleClass.mk L)) = n := by
  let K : InvertibleSheaf P := ⟨Proj.twistingSheaf 𝒜 n, inferInstance⟩
  have hK : LineBundleClass.mk K = twistingClass k n := rfl
  rw [← LineBundleClass.mk_eq_mk_iff (L := L) (K := K), hK]
  exact ((picardDegreeEquiv k).injective.comp Additive.ofMul.injective).eq_iff.symm.trans
    (by simp only [Function.comp_apply, picardDegreeEquiv_twistingClass])

instance : Module.Free ℤ (Additive (LineBundleClass P)) :=
  Module.Free.of_equiv (picardDegreeEquiv k).symm.toIntLinearEquiv

instance : Module.Finite ℤ (Additive (LineBundleClass P)) :=
  Module.Finite.equiv (picardDegreeEquiv k).symm.toIntLinearEquiv

/-- The Picard lattice of the projective plane has rank one. -/
@[simp]
theorem finrank_picard : Module.finrank ℤ (Additive (LineBundleClass P)) = 1 :=
  (picardDegreeEquiv k).toIntLinearEquiv.finrank_eq.trans (Module.finrank_self ℤ)

/-- The Euler characteristic of a line-bundle class of degree `d` on the projective plane
is `(d + 1)(d + 2)/2`. -/
theorem eulerCharBelow_eq (a : Additive (LineBundleClass P)) :
    LineBundleClass.eulerCharBelow k a.toMul 3 =
      (picardDegreeEquiv k a + 1) * (picardDegreeEquiv k a + 2) / 2 := by
  obtain ⟨n, rfl⟩ := (picardDegreeEquiv k).symm.surjective a
  rw [picardDegreeEquiv_symm_apply, picardDegreeEquiv_twistingClass, toMul_ofMul,
    twistingClass, LineBundleClass.eulerCharBelow_mk]
  exact eulerCharBelow_twistingSheaf_projectivePlane k n

private theorem two_mul_eulerCharBelow (a : Additive (LineBundleClass P)) :
    2 * LineBundleClass.eulerCharBelow k a.toMul 3 =
      (picardDegreeEquiv k a + 1) * (picardDegreeEquiv k a + 2) := by
  rw [eulerCharBelow_eq]
  exact Int.mul_ediv_cancel' (even_iff_two_dvd.mp
    (by simpa [add_assoc] using Int.even_mul_succ_self (picardDegreeEquiv k a + 1)))

/-- The surface intersection pairing on `ℙ²_k` is multiplication of the degrees.
In particular the generator `[𝒪(1)]` has self-intersection one. -/
theorem classIntersectionNumber_eq_mul (a b : Additive (LineBundleClass P)) :
    Chow.classIntersectionNumber k P a.toMul b.toMul =
      picardDegreeEquiv k a * picardDegreeEquiv k b := by
  suffices 2 * Chow.classIntersectionNumber k P a.toMul b.toMul =
      2 * (picardDegreeEquiv k a * picardDegreeEquiv k b) by omega
  rw [Chow.classIntersectionNumber_eq, mul_add, mul_sub, mul_sub]
  -- Express the four tensor operations in the additive Picard group for degree evaluation.
  change 2 * LineBundleClass.eulerCharBelow k (Additive.toMul 0 : LineBundleClass P) 3 -
    2 * LineBundleClass.eulerCharBelow k (-a).toMul 3 -
    2 * LineBundleClass.eulerCharBelow k (-b).toMul 3 +
    2 * LineBundleClass.eulerCharBelow k (-a + -b).toMul 3 = _
  simp only [two_mul_eulerCharBelow, map_zero, map_neg, map_add]
  ring

/-- The native Picard intersection form of the projective plane is unimodular. -/
theorem classIntersectionBilinForm_isPerfPair [Infinite k] :
    (Chow.classIntersectionBilinForm k (topologicalKrullDim_eq k)).IsPerfPair := by
  let e := (LinearMap.ringLmapEquivSelf ℤ ℤ ℤ).symm
  have he : e.toLinearMap = LinearMap.mul ℤ ℤ := by
    ext
    simp [e]
  have hmul : (LinearMap.mul ℤ ℤ).IsPerfPair := by
    rw [← he]
    infer_instance
  let deg : Additive (LineBundleClass P) ≃ₗ[ℤ] ℤ := (picardDegreeEquiv k).toIntLinearEquiv
  have hform :
      Chow.classIntersectionBilinForm k (topologicalKrullDim_eq k) =
        (LinearMap.mul ℤ ℤ).compl₁₂ deg deg := by
    refine LinearMap.ext fun a ↦ LinearMap.ext fun b ↦ ?_
    rw [Chow.classIntersectionBilinForm_apply, LinearMap.compl₁₂_apply, LinearMap.mul_apply']
    exact classIntersectionNumber_eq_mul k a b
  rw [hform]
  infer_instance

end

end projectivePlane

end QPainleve
